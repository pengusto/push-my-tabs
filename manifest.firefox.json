{
  "manifest_version": 3,
  "name": "TabCompass",
  "version": "0.1.0",
  "description": "Switch and move tabs with arrow-key shortcuts that follow the browser's tab layout.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "browserSettings"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab layout",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "commands": {
    "arrow-left": {
      "suggested_key": { "default": "Ctrl+Left" },
      "description": "Use the left arrow action"
    },
    "arrow-right": {
      "suggested_key": { "default": "Ctrl+Right" },
      "description": "Use the right arrow action"
    },
    "arrow-up": {
      "suggested_key": { "default": "Ctrl+Up" },
      "description": "Use the up arrow action"
    },
    "arrow-down": {
      "suggested_key": { "default": "Ctrl+Down" },
      "description": "Use the down arrow action"
    }
  }
}
