{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "browserSettings"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "commands": {
    "arrow-left": {
      "suggested_key": { "default": "Ctrl+Left" },
      "description": "__MSG_commandLeftDescription__"
    },
    "arrow-right": {
      "suggested_key": { "default": "Ctrl+Right" },
      "description": "__MSG_commandRightDescription__"
    },
    "arrow-up": {
      "suggested_key": { "default": "Ctrl+Up" },
      "description": "__MSG_commandUpDescription__"
    },
    "arrow-down": {
      "suggested_key": { "default": "Ctrl+Down" },
      "description": "__MSG_commandDownDescription__"
    }
  }
}
