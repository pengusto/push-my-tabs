{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "commands": {
    "arrow-left": {
      "suggested_key": {
        "default": "Alt+Left",
        "mac": "Command+Left"
      },
      "description": "__MSG_commandLeftDescription__"
    },
    "arrow-right": {
      "suggested_key": {
        "default": "Alt+Right",
        "mac": "Command+Right"
      },
      "description": "__MSG_commandRightDescription__"
    },
    "arrow-up": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Command+Up"
      },
      "description": "__MSG_commandUpDescription__"
    },
    "arrow-down": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Command+Down"
      },
      "description": "__MSG_commandDownDescription__"
    },
    "new-tab-before": {
      "description": "__MSG_commandNewTabBeforeDescription__"
    },
    "new-tab-after": {
      "description": "__MSG_commandNewTabAfterDescription__"
    },
    "new-tab-end": {
      "description": "__MSG_commandNewTabEndDescription__"
    },
    "history-back": {
      "description": "__MSG_actionHistoryBack__"
    },
    "history-forward": {
      "description": "__MSG_actionHistoryForward__"
    },
    "recent-tab-quick-switch": {
      "description": "__MSG_commandRecentTabQuickDescription__"
    },
    "recent-tab-switch": {
      "description": "__MSG_commandRecentTabDescription__"
    },
    "recent-tab-switch-reverse": {
      "description": "__MSG_commandRecentTabReverseDescription__"
    }
  }
}
